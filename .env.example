# Local Docker defaults only. Replace every credential outside local development.
MYSQL_DATABASE=reliability_lab
MYSQL_USER=reliability_lab
MYSQL_PASSWORD=reliability_lab_dev
MYSQL_ROOT_PASSWORD=root_dev_password
REDIS_HOST_PORT=6380

# Docker service names are resolvable inside the Compose network.
DATABASE_URL=mysql+pymysql://reliability_lab:reliability_lab_dev@mysql:3306/reliability_lab
EXECUTION_MODE=celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
